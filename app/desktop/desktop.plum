extern "C" {
    fn pl_ui_init();
    fn pl_ui_done() -> Bool;
    fn pl_ui_close_requested() -> Bool;
    fn pl_ui_begin();
    fn pl_ui_end();
    fn pl_ui_close();
    fn pl_ui_width() -> Int;
    fn pl_ui_height() -> Int;
    fn pl_ui_key(key: Int) -> Bool;
    fn pl_ui_down(key: Int) -> Bool;
    fn pl_ui_wheel() -> Int;
    fn pl_ui_rect(x: Int, y: Int, w: Int, h: Int, hex: Int);
    fn pl_ui_text(text: CStr, x: Int, y: Int, size: Int, hex: Int);
    fn pl_ui_clicked(x: Int, y: Int, w: Int, h: Int) -> Bool;
    fn pl_ui_field(id: Int, text: CStr, x: Int, y: Int, w: Int, h: Int, editing: Bool);
    fn pl_ui_value(id: Int) -> CStr;
    fn pl_ui_clip(x: Int, y: Int, w: Int, h: Int);
    fn pl_ui_unclip();
    fn pl_ui_cover(path: CStr, x: Int, y: Int, w: Int, h: Int) -> Bool;
    fn pl_ui_hover(x: Int, y: Int, w: Int, h: Int) -> Bool;
    fn pl_ui_released() -> Bool;
    fn pl_ui_round(x: Int, y: Int, w: Int, h: Int, hex: Int);
    fn pl_ui_measure(text: CStr, size: Int) -> Int;
    fn pl_ui_logo(x: Int, y: Int, size: Int);
    fn pl_ui_image_valid(path: CStr) -> Bool;
    fn pl_ui_enable(enabled: Bool);
    fn pl_ui_interactive(x: Int, y: Int, w: Int, h: Int) -> Bool;
    fn pl_ui_consume_activation();
}

pub let init (): Unit = unsafe { pl_ui_init() }
pub let done (): Bool = unsafe { pl_ui_done() }
pub let close_requested (): Bool = unsafe { pl_ui_close_requested() }
pub let begin (): Unit = unsafe { pl_ui_begin() }
pub let end (): Unit = unsafe { pl_ui_end() }
pub let close (): Unit = unsafe { pl_ui_close() }
pub let width (): Int = unsafe { pl_ui_width() }
pub let height (): Int = unsafe { pl_ui_height() }
pub let key (code: Int): Bool = unsafe { pl_ui_key(code) }
pub let down (code: Int): Bool = unsafe { pl_ui_down(code) }
pub let wheel (): Int = unsafe { pl_ui_wheel() }
pub let rect (x: Int) (y: Int) (w: Int) (h: Int) (color: Int): Unit =
    unsafe { pl_ui_rect(x, y, w, h, color) }
let draw_text (value: String) (x: Int) (y: Int) (size: Int) (color: Int): Unit =
    unsafe { pl_ui_text(value.as_cstr(), x, y, size, color) }
pub let clicked (x: Int) (y: Int) (w: Int) (h: Int): Bool =
    unsafe { pl_ui_clicked(x, y, w, h) }
pub let field (id: Int) (value: String) (x: Int) (y: Int) (w: Int) (h: Int) (editing: Bool): String =
    unsafe {
        pl_ui_field(id, value.as_cstr(), x, y, w, h, editing);
        if value.len() >= 16384 { value } else { pl_ui_value(id).as_string() }
    }
pub let clip (x: Int) (y: Int) (w: Int) (h: Int): Unit = unsafe { pl_ui_clip(x, y, w, h) }
pub let unclip (): Unit = unsafe { pl_ui_unclip() }
pub let cover (path: String) (x: Int) (y: Int) (w: Int) (h: Int): Bool =
    unsafe { pl_ui_cover(path.as_cstr(), x, y, w, h) }

pub let hover (x: Int) (y: Int) (w: Int) (h: Int): Bool = unsafe { pl_ui_hover(x, y, w, h) }
pub let interactive (x: Int) (y: Int) (w: Int) (h: Int): Bool = unsafe { pl_ui_interactive(x, y, w, h) }
pub let consume_activation (): Unit = unsafe { pl_ui_consume_activation() }
pub let released (): Bool = unsafe { pl_ui_released() }
pub let round_rect (x: Int) (y: Int) (w: Int) (h: Int) (color: Int): Unit = unsafe { pl_ui_round(x, y, w, h, color) }
let measure_size (text: String) (size: Int): Int = unsafe { pl_ui_measure(text.as_cstr(), size) }
pub let logo (x: Int) (y: Int) (size: Int): Unit = unsafe { pl_ui_logo(x, y, size) }
pub let image_valid (path: String): Bool = unsafe { pl_ui_image_valid(path.as_cstr()) }
pub let enable (enabled: Bool): Unit = unsafe { pl_ui_enable(enabled) }

pub let outline (x: Int) (y: Int) (w: Int) (h: Int) (color: Int): Unit = {
    rect(x, y, w, 2, color); rect(x, y + h - 2, w, 2, color);
    rect(x, y, 2, h, color); rect(x + w - 2, y, 2, h, color)
}

// Button composition and interaction remain Plum, with C exposing primitives.
pub let action (label: String) (x: Int) (y: Int) (w: Int) (h: Int) (kind: ButtonStyle) (selected: Bool) (focused: Bool): Bool = {
    let over = interactive(x, y, w, h);
    let primary = kind == PrimaryButton;
    let background = if primary { if over { 13684479 } else { accent(()) } }
        else if over || selected { 3422796 } else if kind == NavigationButton { rail(()) }
        else if kind == QuietButton { canvas(()) } else { surface(()) };
    round_rect(x, y, w, h, background);
    if kind == NavigationButton && selected { rect(x, y + 10, 3, h - 20, accent(())) };
    if focused { outline(x - 3, y - 3, w + 6, h + 6, accent(())) };
    let tx = if kind == NavigationButton { x + 14 } else { x + (w - measure_size(label, font_size(BodyText))) / 2 };
    text(label, tx, y + (h - 20) / 2, BodyText, if primary { canvas(()) } else if kind == DangerButton { warning(()) } else { ink(()) });
    (over && released(())) || (focused && (key(257) || key(32)))
}

let wrap_words (words: Array[String]) (index: Int) (line: String) (width: Int) (size: Int) (out: Array[String]): Array[String] =
    if index >= words.len() { out.push(line) }
    else {
        let next = if line == "" { words[index] } else { line.concat(" ").concat(words[index]) };
        if line != "" && measure_size(next, size) > width { wrap_words(words, index + 1, words[index], width, size, out.push(line)) }
        else { wrap_words(words, index + 1, next, width, size, out) }
    }

pub let paragraph (value: String) (x: Int) (y: Int) (width: Int) (style: TextStyle) (color: Int): Int = {
    let size = font_size(style);
    let lines: Array[String] = [];
    for line in value.split("\n") { lines = Array.concat(lines, wrap_words(line.split(" "), 0, "", width, size, [])); };
    for i in 0..lines.len() { draw_text(lines[i], x, y + i * (size + 9), size, color); };
    lines.len() * (size + 9)
}

// Drawing and wrapping resolve the same role through one font policy.
pub let text (value: String) (x: Int) (y: Int) (style: TextStyle) (color: Int): Unit =
    draw_text(value, x, y, font_size(style), color)
